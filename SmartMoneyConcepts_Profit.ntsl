// Indicador Smart Money Concepts (SMC) para Profit Chart / NTSL.
// Adaptacao do conceito de "Smart Money Concepts [LuxAlgo]".
// Original © LuxAlgo, licenca CC BY-NC-SA 4.0:
// https://creativecommons.org/licenses/by-nc-sa/4.0/
// Uso nao comercial; redistribuir sob a mesma licenca e manter a atribuicao.
// Este arquivo usa somente caracteres ASCII por compatibilidade com o editor NTSL.
//
// Port parcial: os sinais sao desenhados com plots/textos e os textos aparecem
// na barra de confirmacao. Nao reproduz caixas, alertas, niveis MTF ou paridade
// visual objeto-a-objeto. Os OBs representam apenas o bloco swing mais recente
// por direcao; Order Blocks internos nao estao incluidos. NTSL nao expoe evento
// de hover do cursor; a coloracao e aplicada somente no candle da quebra.
// Os FVGs exibem apenas o gap mais recente por direcao; um novo gap substitui
// as linhas de qualquer gap anterior ainda nao preenchido nessa direcao.
// A deteccao FVG usa somente Low > High[2] ou High < Low[2], sem filtro para
// fechamento/direcao do candle intermediario ou tamanho minimo do gap.
// Somente as legendas FVG recebem deslocamento; as demais mantem a posicao original.
// Validacao manual no Profit: conferir os limites horizontais e as legendas
// afastadas dos candles em novas ocorrencias de FVG+ e FVG-.

input
  EstruturaSwing(50);
  EstruturaInterna(5);
  BarrasBuscaOB(20);
  ToleranciaEQPercentual(0.10);
  // Percentual nao negativo de Close; 0.05 corresponde a 0.05% do preco.
  FVGLegendaOffsetPercentual(0.05);
  MostrarEstruturaSwing(True);
  MostrarEstruturaInterna(True);
  MostrarSwings(True);
  MostrarEQH_EQL(True);
  MostrarFVG(True);
  MostrarOrderBlocks(True);

var
  i : Integer;
  SwingHighCandidato : Boolean;
  SwingLowCandidato : Boolean;
  InternoHighCandidato : Boolean;
  InternoLowCandidato : Boolean;
  SwingHigh : Float;
  SwingLow : Float;
  InternoHigh : Float;
  InternoLow : Float;
  SwingHighCruza : Boolean;
  SwingLowCruza : Boolean;
  InternoHighCruza : Boolean;
  InternoLowCruza : Boolean;
  QuebraSwingAltaAgora : Boolean;
  QuebraSwingBaixaAgora : Boolean;
  QuebraInternaAltaAgora : Boolean;
  QuebraInternaBaixaAgora : Boolean;
  DirecaoQuebraAgora : Integer;
  TendenciaSwing : Integer;
  TendenciaInterna : Integer;
  EncontrouOB : Boolean;
  OBAltaTopo : Float;
  OBAltaFundo : Float;
  OBBaixaTopo : Float;
  OBBaixaFundo : Float;
  OBAltaAtivo : Boolean;
  OBBaixaAtivo : Boolean;
  FVGAltaTopo : Float;
  FVGAltaFundo : Float;
  FVGBaixaTopo : Float;
  FVGBaixaFundo : Float;
  FVGAltaAtivo : Boolean;
  FVGBaixaAtivo : Boolean;
  FVGLegendaOffset : Float;
  PosicaoTextoAcima : Integer;
  PosicaoTextoAbaixo : Integer;
  TamanhoFonteLegenda : Integer;
  TamanhoFonteEstrutura : Integer;
  ToleranciaEQ : Float;

begin
  PosicaoTextoAcima := 0;
  PosicaoTextoAbaixo := 1;
  TamanhoFonteLegenda := 8;
  TamanhoFonteEstrutura := 10;
  QuebraSwingAltaAgora := False;
  QuebraSwingBaixaAgora := False;
  QuebraInternaAltaAgora := False;
  QuebraInternaBaixaAgora := False;
  DirecaoQuebraAgora := 0;
  ToleranciaEQ := Close * ToleranciaEQPercentual / 100;
  FVGLegendaOffset := 0;
  if FVGLegendaOffsetPercentual > 0 then
    FVGLegendaOffset := Close * FVGLegendaOffsetPercentual / 100;

  if CurrentBar > (EstruturaSwing * 2) then
  begin
    SwingHighCandidato := True;
    SwingLowCandidato := True;
    for i := 0 to (EstruturaSwing * 2) do
    begin
      if High[EstruturaSwing] < High[i] then
        SwingHighCandidato := False;
      if Low[EstruturaSwing] > Low[i] then
        SwingLowCandidato := False;
    end;

    if SwingHighCandidato then
    begin
      if MostrarEQH_EQL and (SwingHigh > 0) and
         (High[EstruturaSwing] <= SwingHigh + ToleranciaEQ) and
         (High[EstruturaSwing] >= SwingHigh - ToleranciaEQ) then
        PlotText("EQH", clRed, PosicaoTextoAcima, TamanhoFonteLegenda, High[EstruturaSwing]);
      SwingHigh := High[EstruturaSwing];
      SwingHighCruza := False;
      if MostrarSwings then
        PlotText("SH", clRed, PosicaoTextoAcima, TamanhoFonteLegenda, High[EstruturaSwing]);
    end;

    if SwingLowCandidato then
    begin
      if MostrarEQH_EQL and (SwingLow > 0) and
         (Low[EstruturaSwing] <= SwingLow + ToleranciaEQ) and
         (Low[EstruturaSwing] >= SwingLow - ToleranciaEQ) then
        PlotText("EQL", clGreen, PosicaoTextoAbaixo, TamanhoFonteLegenda, Low[EstruturaSwing]);
      SwingLow := Low[EstruturaSwing];
      SwingLowCruza := False;
      if MostrarSwings then
        PlotText("SL", clGreen, PosicaoTextoAbaixo, TamanhoFonteLegenda, Low[EstruturaSwing]);
    end;
  end;

  if CurrentBar > (EstruturaInterna * 2) then
  begin
    InternoHighCandidato := True;
    InternoLowCandidato := True;
    for i := 0 to (EstruturaInterna * 2) do
    begin
      if High[EstruturaInterna] < High[i] then
        InternoHighCandidato := False;
      if Low[EstruturaInterna] > Low[i] then
        InternoLowCandidato := False;
    end;

    if InternoHighCandidato then
    begin
      InternoHigh := High[EstruturaInterna];
      InternoHighCruza := False;
    end;
    if InternoLowCandidato then
    begin
      InternoLow := Low[EstruturaInterna];
      InternoLowCruza := False;
    end;
  end;

  // Mitiga primeiro os gaps ativos; qualquer novo FVG detectado nesta barra
  // substitui os niveis anteriores e inicia um novo estado ativo.
  if FVGAltaAtivo and (Low <= FVGAltaFundo) then
    FVGAltaAtivo := False;
  if FVGBaixaAtivo and (High >= FVGBaixaTopo) then
    FVGBaixaAtivo := False;

  if MostrarFVG and (CurrentBar > 2) then
  begin
    if Low > High[2] then
    begin
      FVGAltaTopo := Low;
      FVGAltaFundo := High[2];
      FVGAltaAtivo := True;
      PlotText("FVG+", clGreen, PosicaoTextoAcima, TamanhoFonteLegenda,
               FVGAltaTopo + FVGLegendaOffset);
    end;
    if High < Low[2] then
    begin
      FVGBaixaTopo := Low[2];
      FVGBaixaFundo := High;
      FVGBaixaAtivo := True;
      PlotText("FVG-", clRed, PosicaoTextoAbaixo, TamanhoFonteLegenda,
               FVGBaixaFundo - FVGLegendaOffset);
    end;
  end;

  if OBAltaAtivo and (Low <= OBAltaFundo) then
    OBAltaAtivo := False;
  if OBBaixaAtivo and (High >= OBBaixaTopo) then
    OBBaixaAtivo := False;

  if (SwingHigh > 0) and (not SwingHighCruza) and
     (Close > SwingHigh) and (Close[1] <= SwingHigh) then
  begin
    QuebraSwingAltaAgora := True;
    DirecaoQuebraAgora := 1;
    SwingHighCruza := True;
    if TendenciaSwing = -1 then
      PlotText("CHoCH", clGreen, PosicaoTextoAcima, TamanhoFonteEstrutura, Close)
    else
      PlotText("BOS", clGreen, PosicaoTextoAcima, TamanhoFonteEstrutura, Close);
    TendenciaSwing := 1;

    if MostrarOrderBlocks then
    begin
      EncontrouOB := False;
      if CurrentBar > BarrasBuscaOB then
      begin
        for i := 1 to BarrasBuscaOB do
        begin
          if (not EncontrouOB) and (Open[i] > Close[i]) then
          begin
            OBAltaTopo := High[i];
            OBAltaFundo := Low[i];
            OBAltaAtivo := True;
            EncontrouOB := True;
          end;
        end;
      end;
    end;
  end;

  if (SwingLow > 0) and (not SwingLowCruza) and
     (Close < SwingLow) and (Close[1] >= SwingLow) then
  begin
    QuebraSwingBaixaAgora := True;
    DirecaoQuebraAgora := -1;
    SwingLowCruza := True;
    if TendenciaSwing = 1 then
      PlotText("CHoCH", clRed, PosicaoTextoAbaixo, TamanhoFonteEstrutura, Close)
    else
      PlotText("BOS", clRed, PosicaoTextoAbaixo, TamanhoFonteEstrutura, Close);
    TendenciaSwing := -1;

    if MostrarOrderBlocks then
    begin
      EncontrouOB := False;
      if CurrentBar > BarrasBuscaOB then
      begin
        for i := 1 to BarrasBuscaOB do
        begin
          if (not EncontrouOB) and (Open[i] < Close[i]) then
          begin
            OBBaixaTopo := High[i];
            OBBaixaFundo := Low[i];
            OBBaixaAtivo := True;
            EncontrouOB := True;
          end;
        end;
      end;
    end;
  end;

  if (InternoHigh > 0) and (not InternoHighCruza) and
     (Close > InternoHigh) and (Close[1] <= InternoHigh) then
  begin
    QuebraInternaAltaAgora := True;
    DirecaoQuebraAgora := 1;
    InternoHighCruza := True;
    if MostrarEstruturaInterna then
    begin
      if TendenciaInterna = -1 then
        PlotText("iCHoCH", clLime, PosicaoTextoAcima, TamanhoFonteLegenda, Close)
      else
        PlotText("iBOS", clLime, PosicaoTextoAcima, TamanhoFonteLegenda, Close);
    end;
    TendenciaInterna := 1;
  end;

  if (InternoLow > 0) and (not InternoLowCruza) and
     (Close < InternoLow) and (Close[1] >= InternoLow) then
  begin
    QuebraInternaBaixaAgora := True;
    DirecaoQuebraAgora := -1;
    InternoLowCruza := True;
    if MostrarEstruturaInterna then
    begin
      if TendenciaInterna = 1 then
        PlotText("iCHoCH", clRed, PosicaoTextoAbaixo, TamanhoFonteLegenda, Close)
      else
        PlotText("iBOS", clRed, PosicaoTextoAbaixo, TamanhoFonteLegenda, Close);
    end;
    TendenciaInterna := -1;
  end;

  if MostrarEstruturaSwing then
  begin
    if (SwingHigh > 0) and
       ((not SwingHighCruza) or QuebraSwingAltaAgora) then
    begin
      Plot(SwingHigh);
      SetPlotColor(1, clRed);
    end
    else
      NoPlot(1);
    if (SwingLow > 0) and
       ((not SwingLowCruza) or QuebraSwingBaixaAgora) then
    begin
      Plot2(SwingLow);
      SetPlotColor(2, clGreen);
    end
    else
      NoPlot(2);
  end;
  if not MostrarEstruturaSwing then
  begin
    NoPlot(1);
    NoPlot(2);
  end;

  if MostrarEstruturaInterna then
  begin
    if (InternoHigh > 0) and
       ((not InternoHighCruza) or QuebraInternaAltaAgora) then
    begin
      Plot3(InternoHigh);
      SetPlotColor(3, clMaroon);
      SetPlotStyle(3, psDot);
    end
    else
      NoPlot(3);
    if (InternoLow > 0) and
       ((not InternoLowCruza) or QuebraInternaBaixaAgora) then
    begin
      Plot4(InternoLow);
      SetPlotColor(4, clLime);
      SetPlotStyle(4, psDot);
    end
    else
      NoPlot(4);
  end;
  if not MostrarEstruturaInterna then
  begin
    NoPlot(3);
    NoPlot(4);
  end;

  if MostrarFVG then
  begin
    if FVGAltaAtivo then
    begin
      Plot5(FVGAltaTopo);
      Plot6(FVGAltaFundo);
      SetPlotColor(5, clGreen);
      SetPlotColor(6, clGreen);
    end
    else
    begin
      NoPlot(5);
      NoPlot(6);
    end;
    if FVGBaixaAtivo then
    begin
      Plot7(FVGBaixaTopo);
      Plot8(FVGBaixaFundo);
      SetPlotColor(7, clRed);
      SetPlotColor(8, clRed);
    end
    else
    begin
      NoPlot(7);
      NoPlot(8);
    end;
  end;
  if not MostrarFVG then
  begin
    NoPlot(5);
    NoPlot(6);
    NoPlot(7);
    NoPlot(8);
  end;

  if MostrarOrderBlocks then
  begin
    if OBAltaAtivo then
    begin
      Plot9(OBAltaTopo);
      Plot10(OBAltaFundo);
      SetPlotColor(9, clBlue);
      SetPlotColor(10, clBlue);
    end
    else
    begin
      NoPlot(9);
      NoPlot(10);
    end;
    if OBBaixaAtivo then
    begin
      Plot11(OBBaixaTopo);
      Plot12(OBBaixaFundo);
      SetPlotColor(11, clMaroon);
      SetPlotColor(12, clMaroon);
    end
    else
    begin
      NoPlot(11);
      NoPlot(12);
    end;
  end;
  if not MostrarOrderBlocks then
  begin
    NoPlot(9);
    NoPlot(10);
    NoPlot(11);
    NoPlot(12);
  end;

  if DirecaoQuebraAgora = 1 then
    PaintBar(clGreen)
  else if DirecaoQuebraAgora = -1 then
    PaintBar(clRed);

end;
